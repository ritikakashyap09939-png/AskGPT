# Server port (default: 3000)
PORT=3000

# LLM API provider key (OpenAI, Gemini, etc.)
# Required. Get one at https://platform.openai.com/api-keys
API_KEY=your_api_key_here

# Model name (e.g. gpt-4o-mini, gpt-4o, gemini-2.0-flash)
MODEL_NAME=gpt-4o-mini

# OpenAI-compatible API base URL.
# Works with OpenAI, Gemini (https://generativelanguage.googleapis.com/v1beta/openai/),
# and other OpenAI-compatible providers.
API_BASE=https://api.openai.com/v1

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/askgpt

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: allowed CORS origin (e.g. https://askgpt.onrender.com).
# When unset, only same-origin requests are allowed.
ALLOWED_ORIGIN=