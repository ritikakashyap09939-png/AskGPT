# Server port (default: 3000)
PORT=3000

# LLM API provider key (OpenAI, Gemini, etc.)
# Required. Get one at https://platform.openai.com/api-keys
API_KEY=your_api_key_here

# Model name (e.g. gpt-4o-mini, gpt-4o, gemini-2.0-flash)
MODEL_NAME=gpt-4o-mini

# Optional: comma-separated backup models (e.g. gemini-2.5-flash-lite,gemini-2.5-flash).
# Tried in order when MODEL_NAME returns 500/503/429 or does not respond within 20 seconds.
MODEL_FALLBACKS=

# Image generation model (default: gemini-2.5-flash-image)
IMAGE_MODEL=gemini-2.5-flash-image

# Optional: comma-separated backup image models (e.g. gemini-3.1-flash-image).
# Tried in order when IMAGE_MODEL returns 500/503/429 or does not respond within 60 seconds.
IMAGE_FALLBACKS=

# OpenAI-compatible API base URL.
# Works with OpenAI, Gemini (https://generativelanguage.googleapis.com/v1beta/openai/),
# and other OpenAI-compatible providers.
API_BASE=https://api.openai.com/v1

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/askgpt

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: allowed CORS origin (e.g. https://askgpt.onrender.com).
# When unset, only same-origin requests are allowed.
ALLOWED_ORIGIN=

# Public base URL of this app, used to build OAuth callback URLs.
# Examples: http://localhost:3000 or https://askgpt-gcrx.onrender.com
APP_URL=http://localhost:3000

# Google OAuth (optional). Leave blank to hide the "Continue with Google" button.
# Callback URL registered in Google Cloud Console: APP_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional). Leave blank to hide the "Continue with GitHub" button.
# Callback URL registered in GitHub OAuth settings: APP_URL + /api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Daily usage limits per user (when logged in) or per IP (guest mode)
# Logged-in user daily chat message limit
DAILY_CHAT_LIMIT=40
# Logged-in user daily image generation limit
DAILY_IMAGE_LIMIT=5
# Guest (no MongoDB) daily limit per IP
GUEST_DAILY_LIMIT=15